# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend
FRONTEND_URL=http://localhost:8080

# Email (Resend) — https://resend.com
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=EduSync <onboarding@resend.dev>

# Cron (Railway scheduled job → POST /api/cron/session-reminders)
CRON_SECRET=change-me-to-a-long-random-string

# NVIDIA NIM (AI assistant for teachers + students) — https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Initial password for teacher-added students (Supabase requires min 6 characters)
DEFAULT_STUDENT_PASSWORD=123456
